    "Ta héroïne tire aussi en se déplaçant (toujours actif en tournoi)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your heroine also shoots while moving (always on in the tournament)"
          }
