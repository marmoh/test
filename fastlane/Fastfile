def meta(locale, field)
  f = File.join(FASTLANE_DIR, "metadata", locale, "#{field}.txt")
  File.exist?(f) ? File.read(f).strip : nil
end

# ───────────────────────────── lanes ─────────────────────────────

default_platform(:ios)

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")
    )
  end

  desc "Lecture seule : app, builds, achats intégrés, abonnements et classements"
  lane :status do
    apps = asc(:get, "/v1/apps?filter[bundleId]=#{APP_IDENTIFIER}")["data"]
    if apps.empty?
      UI.important("App #{APP_IDENTIFIER} : absente d'App Store Connect (fiche à créer sur le site)")
      next
    end
    a = apps.first
    UI.message("App : #{a.dig('attributes', 'name')} (id #{a['id']}, langue #{a.dig('attributes', 'primaryLocale')}, SKU #{a.dig('attributes', 'sku')})")
    builds = asc(:get, "/v1/builds?filter[app]=#{a['id']}&sort=-uploadedDate&limit=5")["data"]
    UI.message("Builds : #{builds.empty? ? 'aucun' : builds.map { |b| "#{b.dig('attributes', 'version')} (#{b.dig('attributes', 'processingState')})" }.join(', ')}")
    asc_all("/v1/apps/#{a['id']}/inAppPurchasesV2?limit=200").each do |p|
      UI.message("Achat intégré : #{p.dig('attributes', 'productId')} — #{p.dig('attributes', 'inAppPurchaseType')} — #{p.dig('attributes', 'state')}")
      next unless p.dig("attributes", "state") == "MISSING_METADATA"
      # diagnostic : ce qu'Apple a reçu pour ce produit
      shot = asc(:get, "/v2/inAppPurchases/#{p['id']}/appStoreReviewScreenshot")["data"]
      locs = asc_all("/v2/inAppPurchases/#{p['id']}/inAppPurchaseLocalizations?limit=200").map { |l| "#{l.dig('attributes', 'locale')}:#{l.dig('attributes', 'state')}" }
      prices = (asc(:get, "/v1/inAppPurchasePriceSchedules/#{p['id']}/manualPrices?limit=5")["data"] rescue []).size
      avail = (asc(:get, "/v2/inAppPurchases/#{p['id']}/inAppPurchaseAvailability")["data"] rescue nil)
      UI.message("  capture : #{shot ? shot.dig('attributes', 'assetDeliveryState', 'state') : 'aucune'} ; langues : #{locs.join(', ')} ; prix : #{prices} ; disponibilité : #{avail ? 'oui' : 'non'}")
    end
    asc_all("/v1/apps/#{a['id']}/subscriptionGroups?limit=200").each do |g|
      UI.message("Groupe d'abonnements : #{g.dig('attributes', 'referenceName')} (id #{g['id']})")
      asc_all("/v1/subscriptionGroups/#{g['id']}/subscriptions?limit=200").each do |s|
        UI.message("  #{s.dig('attributes', 'productId')} — #{s.dig('attributes', 'subscriptionPeriod')} — #{s.dig('attributes', 'state')}")
      end
    end
    detail = asc(:get, "/v1/apps/#{a['id']}/gameCenterDetail")["data"] rescue nil
    if detail
      asc_all("/v1/gameCenterDetails/#{detail['id']}/gameCenterLeaderboards?limit=200").each do |l|
        UI.message("Classement : #{l.dig('attributes', 'vendorIdentifier')} — #{l.dig('attributes', 'referenceName')}")
      end
    else
      UI.message("Game Center : pas encore activé pour l'app")
    end
  end

  desc "Lecture seule : groupes TestFlight, testeurs et état de chaque build pour les testeurs"
  lane :testflight_status do
    builds = asc(:get, "/v1/builds?filter[app]=#{app_id}&sort=-uploadedDate&limit=5&include=buildBetaDetail")
    details = (builds["included"] || []).select { |i| i["type"] == "buildBetaDetails" }.to_h { |d| [d["id"], d["attributes"]] }
    builds["data"].each do |b|
      d = details[b.dig("relationships", "buildBetaDetail", "data", "id")] || {}
      UI.message("Build #{b.dig('attributes', 'version')} : traitement #{b.dig('attributes', 'processingState')}, " \
                 "internes #{d['internalBuildState']}, externes #{d['externalBuildState']}, " \
                 "expiré #{b.dig('attributes', 'expired')}, chiffrement déclaré #{b.dig('attributes', 'usesNonExemptEncryption').inspect}")
    end
    groups = asc(:get, "/v1/apps/#{app_id}/betaGroups")["data"]
    UI.important("Aucun groupe de testeurs TestFlight") if groups.empty?
    groups.each do |g|
      a = g["attributes"]
      testers = asc(:get, "/v1/betaGroups/#{g['id']}/betaTesters?limit=50")["data"]
      gbuilds = asc(:get, "/v1/betaGroups/#{g['id']}/builds?limit=10")["data"].map { |b| b.dig("attributes", "version") }
      UI.message("Groupe « #{a['name']} » : #{a['isInternalGroup'] ? 'interne' : 'externe'}, " \
                 "tous les builds #{a['hasAccessToAllBuilds'].inspect}, #{testers.size} testeur(s), builds #{gbuilds.join(', ')}")
      testers.each { |t| UI.message("  testeur #{t.dig('attributes', 'email')} — #{t.dig('attributes', 'state')}") }
    end
  end

  desc "Écrit la note « Quoi tester » (français) d'un build : fastlane testflight_notes build:2 file:fastlane/testflight/2.txt"
  lane :testflight_notes do |options|
    version = options[:build].to_s
    text = File.read(File.expand_path(options[:file].to_s, File.join(__dir__, ".."))).strip
    UI.user_error!("Note vide") if text.empty?
    UI.user_error!("Note trop longue (#{text.length} > 4000)") if text.length > 4000
    build = asc(:get, "/v1/builds?filter[app]=#{app_id}&filter[version]=#{version}")["data"].first
    UI.user_error!("Build #{version} introuvable") unless build
    existing = asc(:get, "/v1/builds/#{build['id']}/betaBuildLocalizations")["data"].find { |l| l.dig("attributes", "locale") == LOCALE }
    if existing
      asc(:patch, "/v1/betaBuildLocalizations/#{existing['id']}",
          { data: { type: "betaBuildLocalizations", id: existing["id"], attributes: { whatsNew: text } } })
    else
      asc(:post, "/v1/betaBuildLocalizations",
          { data: { type: "betaBuildLocalizations", attributes: { locale: LOCALE, whatsNew: text },
                    relationships: { build: { data: { type: "builds", id: build["id"] } } } } })
    end
    UI.success("Note « Quoi tester » du build #{version} (#{LOCALE}) : #{existing ? 'mise à jour' : 'créée'}")
  end

  desc "Crée les achats intégrés du .storekit (prix France, tous les pays, texte français)"
  lane :products do
    existing = asc_all("/v1/apps/#{app_id}/inAppPurchasesV2?limit=200").map { |p| p.dig("attributes", "productId") }
    products.each do |p|
      pid = p["productID"]
      if existing.include?(pid)
        UI.message("= #{pid} existe déjà")
        next
      end
      type = { "Consumable" => "CONSUMABLE", "NonConsumable" => "NON_CONSUMABLE" }.fetch(p["type"])
      iap = asc(:post, "/v2/inAppPurchases", data: {
        type: "inAppPurchases",
        attributes: { name: p["referenceName"], productId: pid, inAppPurchaseType: type,
                      familySharable: p["familyShareable"], reviewNote: REVIEW_NOTES[pid] },
        relationships: { app: rel("apps", app_id) }
      })["data"]
      l = fr(p)
      asc(:post, "/v1/inAppPurchaseLocalizations", data: {
        type: "inAppPurchaseLocalizations",
        attributes: { locale: LOCALE, name: l["displayName"], description: l["description"] },
        relationships: { inAppPurchaseV2: rel("inAppPurchases", iap["id"]) }
      })
      point = price_point("/v2/inAppPurchases/#{iap['id']}/pricePoints", p["displayPrice"])
      asc(:post, "/v1/inAppPurchasePriceSchedules", data: {
        type: "inAppPurchasePriceSchedules",
        relationships: {
          inAppPurchase: rel("inAppPurchases", iap["id"]),
          baseTerritory: rel("territories", BASE_TERRITORY),
          manualPrices: { data: [{ type: "inAppPurchasePrices", id: "${price}" }] }
        }
      }, included: [{
        type: "inAppPurchasePrices", id: "${price}",
        attributes: { startDate: nil },
        relationships: { inAppPurchasePricePoint: rel("inAppPurchasePricePoints", point) }
      }])
      asc(:post, "/v1/inAppPurchaseAvailabilities", data: {
        type: "inAppPurchaseAvailabilities",
        attributes: { availableInNewTerritories: true },
        relationships: { inAppPurchase: rel("inAppPurchases", iap["id"]), availableTerritories: { data: territories } }
      })
      UI.success("+ #{pid} (#{type}, #{p['displayPrice']} €)")
    end
  end

  desc "Crée le groupe « Ordre du Dragon », ses abonnements, leurs prix et l'essai gratuit de 3 jours"
  lane :dragon do
    sk_group = STOREKIT["subscriptionGroups"].first
    group = asc_all("/v1/apps/#{app_id}/subscriptionGroups?limit=200").find { |g| g.dig("attributes", "referenceName") == sk_group["name"] }
    unless group
      group = asc(:post, "/v1/subscriptionGroups", data: {
        type: "subscriptionGroups",
        attributes: { referenceName: sk_group["name"] },
        relationships: { app: rel("apps", app_id) }
      })["data"]
      asc(:post, "/v1/subscriptionGroupLocalizations", data: {
        type: "subscriptionGroupLocalizations",
        attributes: { locale: LOCALE, name: fr(sk_group)["displayName"] },
        relationships: { subscriptionGroup: rel("subscriptionGroups", group["id"]) }
      })
      UI.success("+ groupe #{sk_group['name']}")
    end
    existing = asc_all("/v1/subscriptionGroups/#{group['id']}/subscriptions?limit=200").map { |s| s.dig("attributes", "productId") }
    period = { "P1M" => "ONE_MONTH", "P1Y" => "ONE_YEAR" }
    trial = { "P3D" => "THREE_DAYS", "P1W" => "ONE_WEEK" }
    sk_group["subscriptions"].each do |s|
      pid = s["productID"]
      if existing.include?(pid)
        UI.message("= #{pid} existe déjà")
        next
      end
      sub = asc(:post, "/v1/subscriptions", data: {
        type: "subscriptions",
        attributes: { name: s["referenceName"], productId: pid, subscriptionPeriod: period.fetch(s["recurringSubscriptionPeriod"]),
                      familySharable: s["familyShareable"], groupLevel: s["groupNumber"], reviewNote: REVIEW_NOTES["dragon"] },
        relationships: { group: rel("subscriptionGroups", group["id"]) }
      })["data"]
      l = fr(s)
      asc(:post, "/v1/subscriptionLocalizations", data: {
        type: "subscriptionLocalizations",
        attributes: { locale: LOCALE, name: l["displayName"], description: l["description"] },
        relationships: { subscription: rel("subscriptions", sub["id"]) }
      })
      asc(:post, "/v1/subscriptionAvailabilities", data: {
        type: "subscriptionAvailabilities",
        attributes: { availableInNewTerritories: true },
        relationships: { subscription: rel("subscriptions", sub["id"]), availableTerritories: { data: territories } }
      })
      # prix : France, puis les équivalents calculés par Apple pour les autres pays
      base = price_point("/v1/subscriptions/#{sub['id']}/pricePoints", s["displayPrice"])
      points = [base] + asc_all("/v1/subscriptionPricePoints/#{base}/equalizations?limit=200").map { |p| p["id"] }
      points.each do |pp|
        asc(:post, "/v1/subscriptionPrices", data: {
          type: "subscriptionPrices",
          attributes: { startDate: nil, preserveCurrentPrice: false },
          relationships: { subscription: rel("subscriptions", sub["id"]), subscriptionPricePoint: rel("subscriptionPricePoints", pp) }
        })
      end
      # essai gratuit, pays par pays
      if (offer = s["introductoryOffer"]) && offer["paymentMode"] == "free"
        territories.each do |t|
          asc(:post, "/v1/subscriptionIntroductoryOffers", data: {
            type: "subscriptionIntroductoryOffers",
            attributes: { duration: trial.fetch(offer["subscriptionPeriod"]), offerMode: "FREE_TRIAL", numberOfPeriods: 1 },
            relationships: { subscription: rel("subscriptions", sub["id"]), territory: rel("territories", t[:id]) }
          })
        end
      end
      UI.success("+ #{pid} (#{s['displayPrice']} €, #{points.size} pays, essai #{offer && offer['subscriptionPeriod']})")
    end
    UI.important("Identifiant du groupe « #{sk_group['name']} » : #{group['id']} → ProductID.dragonGroupID")
  end

  desc "Ajoute aux achats intégrés, aux abonnements et au groupe les langues du .storekit absentes d'App Store Connect"
  lane :localize do
    # « en_US » du .storekit → « en-US » d'App Store Connect ; le français est déjà en place
    locales = ->(item) { item["localizations"].reject { |l| l["locale"].start_with?("fr") }.map { |l| [l["locale"].tr("_", "-"), l] } }
    iaps = asc_all("/v1/apps/#{app_id}/inAppPurchasesV2?limit=200").to_h { |p| [p.dig("attributes", "productId"), p["id"]] }
    products.each do |p|
      id = iaps[p["productID"]] or next UI.important("#{p['productID']} absent : lancer d'abord `products`")
      have = asc_all("/v2/inAppPurchases/#{id}/inAppPurchaseLocalizations?limit=200").map { |l| l.dig("attributes", "locale") }
      locales.(p).each do |loc, l|
        next if have.include?(loc)
        asc(:post, "/v1/inAppPurchaseLocalizations", data: {
          type: "inAppPurchaseLocalizations",
          attributes: { locale: loc, name: l["displayName"], description: l["description"] },
          relationships: { inAppPurchaseV2: rel("inAppPurchases", id) }
        })
        UI.success("+ #{p['productID']} #{loc} : #{l['displayName']}")
      end
    end
    sk_group = STOREKIT["subscriptionGroups"].first
    group = asc_all("/v1/apps/#{app_id}/subscriptionGroups?limit=200").find { |g| g.dig("attributes", "referenceName") == sk_group["name"] }
    UI.user_error!("Groupe #{sk_group['name']} absent : lancer d'abord `dragon`") unless group
    have = asc_all("/v1/subscriptionGroups/#{group['id']}/subscriptionGroupLocalizations?limit=200").map { |l| l.dig("attributes", "locale") }
    locales.(sk_group).each do |loc, l|
      next if have.include?(loc)
      asc(:post, "/v1/subscriptionGroupLocalizations", data: {
        type: "subscriptionGroupLocalizations",
        attributes: { locale: loc, name: l["displayName"] },
        relationships: { subscriptionGroup: rel("subscriptionGroups", group["id"]) }
      })
      UI.success("+ groupe #{loc} : #{l['displayName']}")
    end
    subs = asc_all("/v1/subscriptionGroups/#{group['id']}/subscriptions?limit=200").to_h { |s| [s.dig("attributes", "productId"), s["id"]] }
    subscriptions.each do |s|
      id = subs[s["productID"]] or next UI.important("#{s['productID']} absent : lancer d'abord `dragon`")
      have = asc_all("/v1/subscriptions/#{id}/subscriptionLocalizations?limit=200").map { |l| l.dig("attributes", "locale") }
      locales.(s).each do |loc, l|
        next if have.include?(loc)
        asc(:post, "/v1/subscriptionLocalizations", data: {
          type: "subscriptionLocalizations",
          attributes: { locale: loc, name: l["displayName"], description: l["description"] },
          relationships: { subscription: rel("subscriptions", id) }
        })
        UI.success("+ #{s['productID']} #{loc} : #{l['displayName']}")
      end
    end
  end

  desc "Envoie la capture pour la vérification d'Apple de chaque achat intégré et abonnement qui n'en a pas"
  lane :review_screenshots do
    shots = File.join(ROOT, "docs", "screens", "ios")
    shot_for = ->(pid) { File.join(shots, pid.start_with?("ombrelune.pass.") ? "04-pass.png" : "03-shop.png") }
    targets = asc_all("/v1/apps/#{app_id}/inAppPurchasesV2?limit=200").map do |p|
      [p.dig("attributes", "productId"), "/v2/inAppPurchases/#{p['id']}/appStoreReviewScreenshot",
       "inAppPurchaseAppStoreReviewScreenshots", { inAppPurchaseV2: rel("inAppPurchases", p["id"]) }]
    end
    asc_all("/v1/apps/#{app_id}/subscriptionGroups?limit=200").each do |g|
      asc_all("/v1/subscriptionGroups/#{g['id']}/subscriptions?limit=200").each do |s|
        targets << [s.dig("attributes", "productId"), "/v1/subscriptions/#{s['id']}/appStoreReviewScreenshot",
                    "subscriptionAppStoreReviewScreenshots", { subscription: rel("subscriptions", s["id"]) }]
      end
    end
    targets.each do |pid, existing_path, type, relationships|
      if (old = asc(:get, existing_path)["data"])
        state = old.dig("attributes", "assetDeliveryState", "state")
        if state == "COMPLETE"
          UI.message("= #{pid} a déjà sa capture")
          next
        end
        # capture reçue mais jamais traitée par Apple (reste en UPLOAD_COMPLETE, ou FAILED) : on la renvoie
        asc(:delete, "/v1/#{type}/#{old['id']}")
        UI.important("~ #{pid} : capture #{state} supprimée, nouvel envoi")
      end
      file = shot_for.(pid)
      bytes = File.binread(file)
      reserved = asc(:post, "/v1/#{type}", data: {
        type: type,
        attributes: { fileName: File.basename(file), fileSize: bytes.bytesize },
        relationships: relationships
      })["data"]
      reserved.dig("attributes", "uploadOperations").each do |op|
        uri = URI(op["url"])
        req = Net::HTTP.const_get(op["method"].capitalize).new(uri)
        op["requestHeaders"].each { |h| req[h["name"]] = h["value"] }
        req.body = bytes.byteslice(op["offset"], op["length"])
        res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(req) }
        UI.user_error!("Envoi de #{File.basename(file)} pour #{pid} → #{res.code}") unless res.code.to_i.between?(200, 299)
      end
      asc(:patch, "/v1/#{type}/#{reserved['id']}", data: {
        type: type, id: reserved["id"],
        attributes: { uploaded: true, sourceFileChecksum: Digest::MD5.hexdigest(bytes) }
      })
      UI.success("+ #{pid} : #{File.basename(file)}")
    end
  end

  desc "Fiche App Store 1.0 : textes fr/en/es, catégories, âge, captures, prix, pays, contact, Game Center (apply:true pour envoyer, build:N pour attacher un build)"
  lane :listing do |options|
    apply = options[:apply].to_s == "true"
    say = ->(msg) { apply ? UI.success("✓ #{msg}") : UI.important("→ #{msg}") }
    UI.message(apply ? "Envoi sur App Store Connect" : "Simulation : rien n'est envoyé (apply:true pour envoyer)")

    # 1. Version : numéro, copyright, sortie après validation
    version = asc_all("/v1/apps/#{app_id}/appStoreVersions?filter[platform]=IOS&limit=10")
              .find { |v| %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED METADATA_REJECTED].include?(v.dig("attributes", "appStoreState")) }
    UI.user_error!("Aucune version modifiable") unless version
    vattrs = { versionString: LISTING_VERSION, copyright: COPYRIGHT, releaseType: "AFTER_APPROVAL" }
              .reject { |k, v| version.dig("attributes", k.to_s) == v }
    unless vattrs.empty?
      say.("version : #{vattrs.map { |k, v| "#{k} « #{v} »" }.join(', ')}")
      asc(:patch, "/v1/appStoreVersions/#{version['id']}", data: { type: "appStoreVersions", id: version["id"], attributes: vattrs }) if apply
    end

    # 2. App : droits sur le contenu (aucun contenu de tiers)
    app = asc(:get, "/v1/apps/#{app_id}")["data"]
    unless app.dig("attributes", "contentRightsDeclaration") == "DOES_NOT_USE_THIRD_PARTY_CONTENT"
      say.("droits sur le contenu : aucun contenu de tiers")
      asc(:patch, "/v1/apps/#{app_id}", data: { type: "apps", id: app_id,
        attributes: { contentRightsDeclaration: "DOES_NOT_USE_THIRD_PARTY_CONTENT" } }) if apply
    end

    # 3. Catégories
    info = asc_all("/v1/apps/#{app_id}/appInfos?limit=5").find { |i| i.dig("attributes", "state") != "READY_FOR_DISTRIBUTION" }
    say.("catégories : #{CATEGORIES.values.join(' · ')}")
    asc(:patch, "/v1/appInfos/#{info['id']}", data: { type: "appInfos", id: info["id"],
      relationships: CATEGORIES.transform_values { |c| rel("appCategories", c) } }) if apply

    # 4. Nom, sous-titre, confidentialité (par langue)
    infolocs = asc_all("/v1/appInfos/#{info['id']}/appInfoLocalizations?limit=50").to_h { |l| [l.dig("attributes", "locale"), l] }
    LISTING_LOCALES.each do |loc|
      attrs = { name: meta(loc, "name"), subtitle: meta(loc, "subtitle"), privacyPolicyUrl: meta(loc, "privacy_url") }
      if (l = infolocs[loc])
        diff = attrs.reject { |k, v| l.dig("attributes", k.to_s) == v }
        next if diff.empty?
        say.("#{loc} infos : #{diff.map { |k, v| "#{k} « #{v} »" }.join(', ')}")
        asc(:patch, "/v1/appInfoLocalizations/#{l['id']}", data: { type: "appInfoLocalizations", id: l["id"], attributes: diff }) if apply
      else
        say.("#{loc} infos (nouvelle langue) : #{attrs.map { |k, v| "#{k} « #{v} »" }.join(', ')}")
        asc(:post, "/v1/appInfoLocalizations", data: { type: "appInfoLocalizations", attributes: attrs.merge(locale: loc),
          relationships: { appInfo: rel("appInfos", info["id"]) } }) if apply
      end
    end

    # 5. Description, mots-clés, texte promotionnel, assistance (par langue) et captures 6,9 po
    vlocs = asc_all("/v1/appStoreVersions/#{version['id']}/appStoreVersionLocalizations?limit=50").to_h { |l| [l.dig("attributes", "locale"), l] }
    LISTING_LOCALES.each do |loc|
      attrs = { description: meta(loc, "description"), keywords: meta(loc, "keywords"),
                promotionalText: meta(loc, "promotional_text"), supportUrl: meta(loc, "support_url") }
      UI.user_error!("#{loc} : description > 4000 caractères") if attrs[:description].size > 4000
      UI.user_error!("#{loc} : mots-clés > 100 caractères") if attrs[:keywords].size > 100
      l = vlocs[loc]
      if l
        diff = attrs.reject { |k, v| l.dig("attributes", k.to_s) == v }
        unless diff.empty?
          say.("#{loc} fiche : #{diff.keys.join(', ')}")
          asc(:patch, "/v1/appStoreVersionLocalizations/#{l['id']}", data: { type: "appStoreVersionLocalizations", id: l["id"], attributes: diff }) if apply
        end
      else
        say.("#{loc} fiche (nouvelle langue) : #{attrs.keys.join(', ')}")
        l = asc(:post, "/v1/appStoreVersionLocalizations", data: { type: "appStoreVersionLocalizations", attributes: attrs.merge(locale: loc),
          relationships: { appStoreVersion: rel("appStoreVersions", version["id"]) } })["data"] if apply
      end
      files = Dir[File.join(ROOT, "docs", "screens", "appstore", SCREEN_LOCALE[loc], "*.png")].sort
      next if files.empty?
      existing = l ? asc_all("/v1/appStoreVersionLocalizations/#{l['id']}/appScreenshotSets?limit=50")
                       .find { |st| st.dig("attributes", "screenshotDisplayType") == SCREEN_TYPE } : nil
      count = existing ? asc_all("/v1/appScreenshotSets/#{existing['id']}/appScreenshots?limit=50").size : 0
      next UI.message("= #{loc} : #{count} captures déjà en place, laissées telles quelles") if count > 0
      say.("#{loc} captures 6,9 po : #{files.map { |f| File.basename(f) }.join(', ')}")
      next unless apply
      set = existing || asc(:post, "/v1/appScreenshotSets", data: { type: "appScreenshotSets", attributes: { screenshotDisplayType: SCREEN_TYPE },
        relationships: { appStoreVersionLocalization: rel("appStoreVersionLocalizations", l["id"]) } })["data"]
      files.each { |f| upload_asset("appScreenshots", { appScreenshotSet: rel("appScreenshotSets", set["id"]) }, f) }
    end

    # 6. Classification par âge
    age = asc(:get, "/v1/appInfos/#{info['id']}/ageRatingDeclaration")["data"]
    diff = AGE_RATING.reject { |k, v| age.dig("attributes", k.to_s) == v }
    unless diff.empty?
      say.("classification par âge : #{diff.size} réponses (violence de fantaisie légère, le reste « aucun » / « non »)")
      asc(:patch, "/v1/ageRatingDeclarations/#{age['id']}", data: { type: "ageRatingDeclarations", id: age["id"], attributes: diff }) if apply
    end

    # 7. Contact et notes pour la vérification
    ref = asc(:get, "/v1/apps?filter[bundleId]=#{CONTACT_FROM_BUNDLE}")["data"].first
    ref_version = asc_all("/v1/apps/#{ref['id']}/appStoreVersions?filter[appStoreState]=READY_FOR_SALE&limit=1").first
    contact = asc(:get, "/v1/appStoreVersions/#{ref_version['id']}/appStoreReviewDetail")["data"]["attributes"]
                .slice("contactFirstName", "contactLastName", "contactPhone", "contactEmail")
    notes = File.read(File.join(FASTLANE_DIR, "metadata", "review_notes.txt")).strip
    UI.user_error!("Notes de vérification > 4000 caractères") if notes.size > 4000
    rattrs = contact.merge("notes" => notes, "demoAccountRequired" => false)
    rd = asc(:get, "/v1/appStoreVersions/#{version['id']}/appStoreReviewDetail")["data"]
    if rd
      diff = rattrs.reject { |k, v| rd.dig("attributes", k) == v }
      unless diff.empty?
        say.("vérification : #{diff.keys.join(', ')} (contact repris de #{CONTACT_FROM_BUNDLE})")
        asc(:patch, "/v1/appStoreReviewDetails/#{rd['id']}", data: { type: "appStoreReviewDetails", id: rd["id"], attributes: diff }) if apply
      end
    else
      say.("vérification : contact repris de #{CONTACT_FROM_BUNDLE}, notes (#{notes.size} caractères)")
      asc(:post, "/v1/appStoreReviewDetails", data: { type: "appStoreReviewDetails", attributes: rattrs,
        relationships: { appStoreVersion: rel("appStoreVersions", version["id"]) } }) if apply
    end

    # 8. Prix : gratuit
    manual = (asc_all("/v1/appPriceSchedules/#{app_id}/manualPrices?limit=10") rescue [])
    if manual.empty?
      free = asc_all("/v1/apps/#{app_id}/appPricePoints?filter[territory]=#{BASE_TERRITORY}&limit=200")
             .find { |p| p.dig("attributes", "customerPrice").to_f.zero? }
      say.("prix : gratuit (pays de référence #{BASE_TERRITORY})")
      asc(:post, "/v1/appPriceSchedules", data: { type: "appPriceSchedules",
        relationships: { app: rel("apps", app_id), baseTerritory: rel("territories", BASE_TERRITORY),
                         manualPrices: { data: [{ type: "appPrices", id: "${free}" }] } } },
        included: [{ type: "appPrices", id: "${free}", attributes: { startDate: nil },
                     relationships: { appPricePoint: rel("appPricePoints", free["id"]) } }]) if apply
    end

    # 9. Disponibilité : tous les pays, et les futurs
    avail = (asc(:get, "/v1/apps/#{app_id}/appAvailabilityV2")["data"] rescue nil)
    unless avail
      say.("disponibilité : #{territories.size} pays et les nouveaux pays")
      asc(:post, "/v2/appAvailabilities", data: { type: "appAvailabilities", attributes: { availableInNewTerritories: true },
        relationships: { app: rel("apps", app_id),
                         territoryAvailabilities: { data: territories.map { |t| { type: "territoryAvailabilities", id: "${#{t[:id]}}" } } } } },
        included: territories.map { |t| { type: "territoryAvailabilities", id: "${#{t[:id]}}", attributes: { available: true },
                                          relationships: { territory: rel("territories", t[:id]) } } }) if apply
    end

    # 10. Game Center activé pour cette version
    gcv = (asc(:get, "/v1/appStoreVersions/#{version['id']}/gameCenterAppVersion")["data"] rescue nil)
    unless gcv
      say.("Game Center activé pour la version #{LISTING_VERSION}")
      asc(:post, "/v1/gameCenterAppVersions", data: { type: "gameCenterAppVersions",
        relationships: { appStoreVersion: rel("appStoreVersions", version["id"]) } }) if apply
    end

    # 11. Build
    if (number = options[:build])
      build = asc(:get, "/v1/builds?filter[app]=#{app_id}&filter[version]=#{number}&filter[preReleaseVersion.version]=#{LISTING_VERSION}&limit=1")["data"].first
      UI.user_error!("Build #{LISTING_VERSION} (#{number}) introuvable") unless build
      UI.user_error!("Build #{number} pas encore traité (#{build.dig('attributes', 'processingState')})") unless build.dig("attributes", "processingState") == "VALID"
      say.("build #{LISTING_VERSION} (#{number}) attaché à la version")
      asc(:patch, "/v1/appStoreVersions/#{version['id']}/relationships/build", data: { type: "builds", id: build["id"] }) if apply
    end
  end

  desc "Active Game Center et crée le classement récurrent du tournoi"
  lane :leaderboard do
    detail = (asc(:get, "/v1/apps/#{app_id}/gameCenterDetail")["data"] rescue nil)
    detail ||= asc(:post, "/v1/gameCenterDetails", data: {
      type: "gameCenterDetails",
      relationships: { app: rel("apps", app_id) }
    })["data"]
    existing = asc_all("/v1/gameCenterDetails/#{detail['id']}/gameCenterLeaderboards?limit=200")
    if existing.any? { |l| l.dig("attributes", "vendorIdentifier") == LEADERBOARD[:vendor_id] }
      UI.message("= #{LEADERBOARD[:vendor_id]} existe déjà")
      next
    end
    board = asc(:post, "/v1/gameCenterLeaderboards", data: {
      type: "gameCenterLeaderboards",
      attributes: {
        referenceName: LEADERBOARD[:reference_name], vendorIdentifier: LEADERBOARD[:vendor_id],
        defaultFormatter: "INTEGER", submissionType: "BEST_SCORE", scoreSortType: "DESC",
        scoreRangeStart: LEADERBOARD[:range][0], scoreRangeEnd: LEADERBOARD[:range][1],
        recurrenceStartDate: LEADERBOARD[:start], recurrenceDuration: "PT168H", recurrenceRule: "FREQ=DAILY;INTERVAL=7"
      },
      relationships: { gameCenterDetail: rel("gameCenterDetails", detail["id"]) }
    })["data"]
    asc(:post, "/v1/gameCenterLeaderboardLocalizations", data: {
      type: "gameCenterLeaderboardLocalizations",
      attributes: { locale: LOCALE, name: LEADERBOARD[:name], formatterSuffix: " points", formatterSuffixSingular: " point" },
      relationships: { gameCenterLeaderboard: rel("gameCenterLeaderboards", board["id"]) }
    })
    UI.success("+ classement #{LEADERBOARD[:vendor_id]} (hebdomadaire depuis #{LEADERBOARD[:start]})")
  end

  desc "Archive Release, export App Store et envoi sur TestFlight (sans soumission à la vérification)"
  lane :beta do
    ipa = build_app(
      project: File.join(ROOT, "ios", "Ombrelune.xcodeproj"),
      scheme: "Ombrelune",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(FASTLANE_DIR, "build"),
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )
    upload_to_testflight(ipa: ipa, skip_waiting_for_build_processing: true, skip_submission: true)
  end
end
