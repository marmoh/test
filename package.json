{
  "name": "ombrelune",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "rooms:check": "tsx tools/src/rooms-check.ts",
    "levels:gen": "tsx tools/src/levels-gen.ts",
    "levels:validate": "tsx tools/src/levels-validate.ts",
    "bots:balance": "tsx tools/src/powers-balance.ts",
    "bots:loops": "tsx tools/src/loops-report.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm rooms:check && pnpm levels:validate --check",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:shots": "node tools/web-shots.mjs",
    "web:artifact": "pnpm web:build && node tools/web-artifact.mjs",
    "art:atlas": "node tools/art-atlas.mjs",
    "traces": "tsx tools/src/replay-traces.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "^2.1.8"
  }
}
